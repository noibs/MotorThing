[
    {
        "label": "Pico: run current file",
        "command": "uv",
        "args": ["run", "mpremote", "mount", ".", "run", "$ZED_FILE"],
        "cwd": "$ZED_WORKTREE_ROOT",
        "tags": ["python-module-main-method"],
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
    },
    {
        "label": "Pico: upload project",
        "command": "uv",
        "args": [
            "run",
            "mpremote",
            "cp",
            "stepper_motor.py",
            ":stepper_motor.py",
            "+",
            "cp",
            "main.py",
            ":main.py",
            "+",
            "reset",
        ],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "Pico: list files",
        "command": "uv",
        "args": ["run", "mpremote", "ls"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "Pico: REPL with project",
        "command": "uv",
        "args": ["run", "mpremote", "mount", ".", "repl"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
]
